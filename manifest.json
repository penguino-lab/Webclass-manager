{
  "manifest_version": 3,
  "name": "WebClass Library Manager",
  "version": "0.9.1",
  "minimum_chrome_version": "133",
  "description": "WebClassの講義資料を講義ごとに保存し、ライブラリで閲覧・検索できます。",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:"},
  "permissions": ["downloads", "storage", "scripting", "tabs", "offscreen", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "options_page": "library.html",
  "web_accessible_resources": [{"resources":["images/library-preview.webp"],"matches":["https://*/*","http://localhost/*","http://127.0.0.1/*"]}],
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "action": {"default_title": "WebClassを開く", "default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"}}
}
